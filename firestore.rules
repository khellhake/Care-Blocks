rules_version = '2';
// Anyone with the app link can read and write (no login) — that's intentional for a family tool.
// These rules only check that documents have the right shape and reasonable sizes.
service cloud.firestore {
  match /databases/{database}/documents {
    function isDate(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function isName(v) { return v is string && v.size() > 0 && v.size() <= 40; }

    match /settings/main {
      allow read: if true;
      allow write: if request.resource.data.size() <= 20
        && (!('startDate' in request.resource.data) || isDate(request.resource.data.startDate))
        && (!('endDate' in request.resource.data) || isDate(request.resource.data.endDate));
    }

    match /assignments/{blockStart} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if blockStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isName(request.resource.data.person)
        && request.resource.data.isOther is bool
        && request.resource.data.keys().hasOnly(['person', 'isOther', 'updatedAt']);
    }

    match /blockouts/{id} {
      allow read: if true;
      allow delete: if true;
      allow create: if isName(request.resource.data.person)
        && isDate(request.resource.data.start)
        && isDate(request.resource.data.end)
        && request.resource.data.start <= request.resource.data.end
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 120))
        && request.resource.data.keys().hasOnly(['person', 'start', 'end', 'note', 'createdAt']);
      allow update: if false;
    }
  }
}
